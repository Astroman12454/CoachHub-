DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Signs session cookies; a random one is generated at boot if
# unset, which invalidates every existing session's signature on restart
# even though sessions themselves persist in Postgres. Set your own fixed
# value in production so a redeploy doesn't log everyone out.
# SESSION_SECRET=

# Optional — billing (Stripe). The app runs fine without these; accounts
# just can't upgrade past the free plan until they're set. See
# server/scripts/setup-stripe.ts to create the four products/prices below,
# and Stripe's dashboard to register the webhook endpoint at
# <your-deployed-url>/api/webhooks/stripe. STRIPE_PRICE_ID_PAID_MONTHLY is
# the only one required for billing to work at all — annual and Club are
# each independently optional; checkout for a plan/interval whose price id
# isn't set just returns "not available yet" instead of failing everything.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_PAID_MONTHLY=
# STRIPE_PRICE_ID_PAID_ANNUAL=
# STRIPE_PRICE_ID_CLUB_MONTHLY=
# STRIPE_PRICE_ID_CLUB_ANNUAL=
# STRIPE_WEBHOOK_SECRET=

# Optional — AI box-score import (paid-plan feature: upload a photo/PDF of a
# game's box score and have it read into a game automatically). Costs a
# small amount per upload via the Anthropic API. The app runs fine without
# this; the upload button just shows a "not configured" error until it's set.
# ANTHROPIC_API_KEY=

# Optional — push notifications (session/game reminders to players who
# opted in from their portal link). The app runs fine without these; the
# "enable notifications" button just stays hidden on the portal. Generate
# a key pair once with `npx web-push generate-vapid-keys`. VAPID_SUBJECT
# must be a mailto: address or https:// URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Optional — transactional email (Resend). Used for "forgot password" links
# and the automatic weekly digest email to coaches. The app runs fine
# without these; reset-password returns a 503, and the digest just skips
# the email leg (push still goes out if VAPID is configured). Create an
# API key at resend.com and verify a sending domain there — the free tier
# (resend.dev) works for testing but shouldn't be used for real delivery.
# RESEND_FROM_EMAIL must be an address on a domain you verified.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Optional — automatic session reminders (~2h before) and a weekly digest
# (push to portal subscribers, email to the coach), replacing the manual
# "Notify" button. Runs in-process every 15 min, which is enough on an
# always-on deployment. On Render's free tier the whole process sleeps
# after inactivity, so ALSO point an external pinger (a Render Cron Job,
# cron-job.org, a GitHub Actions schedule, ...) at
# POST <your-deployed-url>/api/cron/notifications every ~15 min with header
# `x-cron-secret: <this value>` (or ?secret=<this value>) for reliable
# delivery even while the dyno would otherwise be asleep. Without
# CRON_SECRET set, that endpoint returns a 503 and only the in-process
# scheduler runs.
# CRON_SECRET=
# Base URL used in the weekly digest email's link back to the app —
# defaults to http://localhost:5000 (fine for local dev, wrong for prod).
# APP_URL=
